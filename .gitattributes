# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# Explicit LF for shell scripts and Makefiles (critical for Docker / Linux execution)
*.sh text eol=lf
Makefile text eol=lf

# Explicit CRLF for Windows shell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

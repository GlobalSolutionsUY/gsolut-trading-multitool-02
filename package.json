{
  "name": "gsolut-trading-multitool",
  "version": "0.1.0",
  "private": true,
  "description": "Modular trading intelligence radar and copilot for human-in-the-loop decisions",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
